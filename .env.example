# =============================================================================
# AFRA - Autonomous Financial Research Agent
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
# =============================================================================

# --- LLM Provider Configuration ---
# Choose your primary LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI API Key (required if LLM_PROVIDER=openai)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key (required if LLM_PROVIDER=anthropic)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# LLM Model Selection
# OpenAI options: gpt-4o, gpt-4o-mini (recommended for dev)
# Anthropic options: claude-sonnet-4-20250514
LLM_MODEL=gpt-4o-mini

# Embedding Model (for vector DB)
# Options: text-embedding-3-small (recommended), text-embedding-3-large
EMBEDDING_MODEL=text-embedding-3-small

# --- Financial Data APIs ---
# Financial Modeling Prep (recommended) - https://financialmodelingprep.com/
FMP_API_KEY=

# Alpha Vantage (alternative) - https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=

# --- Search & News APIs ---
# Tavily (recommended for agents) - https://tavily.com/
TAVILY_API_KEY=tvly-...

# NewsAPI.org - https://newsapi.org/
NEWSAPI_KEY=

# --- SEC EDGAR ---
# Required: User-Agent header for SEC EDGAR API (format: "AppName email@example.com")
SEC_EDGAR_USER_AGENT=AFRA research-agent contact@example.com

# --- Vector Database ---
# Options: chroma (recommended for dev), pinecone, qdrant
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Pinecone (optional) - https://www.pinecone.io/
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=afra-research

# --- Agent Configuration ---
# Maximum number of tool calls per research task
MAX_TOOL_CALLS=20

# Maximum retries for failed API calls
MAX_RETRIES=5

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
